{
  "name": "durtup-official-online-shopping-platform",
  "version": "1.0.0",
  "description": "Durtup Official Online Shopping Platform Admin App",
  "author": "Durtup",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate_sitemaps.cjs && node scripts/prerender_products.cjs",
    "build:dev": "vite build --mode development",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:8080 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "sitemap": "node scripts/generate_sitemaps.cjs",
    "icons": "node scripts/generate_favicons.cjs",
    "prerender": "node scripts/prerender_products.cjs",
    "test:seo": "node scripts/validate_seo.cjs"
  },
  "dependencies": {
