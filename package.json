    "firebase": "^12.17.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.12.0",
    "recharts": "^2.15.4",
    "seroval": "^1.6.7",
